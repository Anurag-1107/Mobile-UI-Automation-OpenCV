        "\n",
        "# Create folders\n",
        "for folder in [\n",
        "    dataset_root / \"images/train\",\n",
        "    dataset_root / \"images/val\",\n",
        "    dataset_root / \"images/test\",\n",
        "    dataset_root / \"labels/train\",\n",
