        "import os\n",
        "import shutil\n",
        "import random\n",
        "from pathlib import Path\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Paths\n",
        "# --------------------------------------------------\n",
        "\n",
        "source_images = Path(\"/content/PE_all/images\")\n",
        "source_labels = Path(\"/content/PE_all/labels\")\n",
        "\n",
        "dataset_root = Path(\"/content/PE_dataset\")\n",
        "\n",
        "train_images = dataset_root / \"images/train\"\n",
        "val_images   = dataset_root / \"images/val\"\n",
        "test_images  = dataset_root / \"images/test\"\n",
        "\n",
        "train_labels = dataset_root / \"labels/train\"\n",
        "val_labels   = dataset_root / \"labels/val\"\n",
        "test_labels  = dataset_root / \"labels/test\"\n",
        "\n",
        "# Create folders\n",
        "for folder in [\n",
        "    train_images, val_images, test_images,\n",
        "    train_labels, val_labels, test_labels\n",
        "]:\n",
        "    folder.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Collect images\n",
        "# --------------------------------------------------\n",
        "\n",
        "image_files = sorted([\n",
        "    p for p in source_images.iterdir()\n",
        "    if p.suffix.lower() in [\".jpg\", \".jpeg\", \".png\"]\n",
        "])\n",
        "\n",
        "print(\"Total images:\", len(image_files))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Verify every image has a label\n",
        "# --------------------------------------------------\n",
        "\n",
        "valid_pairs = []\n",
        "\n",
        "for image_path in image_files:\n",
        "\n",
        "    label_path = source_labels / f\"{image_path.stem}.txt\"\n",
        "\n",
        "    if not label_path.exists():\n",
        "        print(\"Missing label:\", image_path.name)\n",
        "        continue\n",
        "\n",
        "    valid_pairs.append((image_path, label_path))\n",
        "\n",
        "print(\"Valid image-label pairs:\", len(valid_pairs))\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Reproducible random shuffle\n",
        "# --------------------------------------------------\n",
        "\n",
        "random.seed(42)\n",
        "random.shuffle(valid_pairs)\n",
        "\n",
        "# --------------------------------------------------\n",
        "# Split 70 / 15 / 15\n",
        "# --------------------------------------------------\n",
        "\n",
        "n = len(valid_pairs)\n",
        "\n",
        "n_train = int(n * 0.70)\n",
        "n_val   = int(n * 0.15)\n",
        "\n",
        "train_pairs = valid_pairs[:n_train]\n",
        "val_pairs   = valid_pairs[n_train:n_train + n_val]\n",
        "test_pairs  = valid_pairs[n_train + n_val:]\n",
