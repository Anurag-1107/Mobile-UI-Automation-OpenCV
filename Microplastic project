        "# ==========================================\n",
        "# PE MICROPLASTIC DETECTION PROTOTYPE\n",
        "# ==========================================\n",
        "\n",
        "from ultralytics import YOLO\n",
        "from google.colab import files\n",
        "from PIL import Image\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "import os\n",
        "\n",
        "# Load trained model\n",
        "model = YOLO(\"/content/PE_training/yolov8n_PE/weights/best.pt\")\n",
        "\n",
        "# Upload a microscope JPG image\n",
        "print(\"Upload a microscope JPG image:\")\n",
        "uploaded = files.upload()\n",
        "\n",
        "image_path = list(uploaded.keys())[0]\n",
        "\n",
        "# Start processing timer\n",
        "start_time = time.time()\n",
        "\n",
        "# Run PE detection\n",
        "results = model.predict(\n",
        "    source=image_path,\n",
        "    imgsz=640,\n",
        "    conf=0.25,\n",
        "    device=0,\n",
        "    verbose=False\n",
        ")\n",
        "\n",
        "processing_time = time.time() - start_time\n",
        "\n",
        "# Get first result\n",
        "result = results[0]\n",
        "\n",
        "# Number of detected PE particles\n",
        "pe_count = len(result.boxes)\n",
        "\n",
        "# Confidence values\n",
        "if pe_count > 0:\n",
        "    confidences = result.boxes.conf.cpu().numpy()\n",
        "    average_confidence = confidences.mean()\n",
        "    maximum_confidence = confidences.max()\n",
        "else:\n",
        "    average_confidence = 0\n",
        "    maximum_confidence = 0\n",
        "\n",
        "# Display annotated image\n",
        "annotated_image = result.plot()\n",
        "\n",
        "plt.figure(figsize=(12, 8))\n",
        "plt.imshow(annotated_image[:, :, ::-1])\n",
        "plt.axis(\"off\")\n",
        "plt.title(f\"PE Microplastic Detection — {pe_count} particles detected\")\n",
        "plt.show()\n",
        "\n",
        "# Display results\n",
        "print(\"=\" * 50)\n",
        "print(\"PE MICROPLASTIC DETECTION RESULT\")\n",
        "print(\"=\" * 50)\n",
        "print(\"Input image:\", image_path)\n",
        "print(\"Predicted PE particles:\", pe_count)\n",
        "print(f\"Average confidence: {average_confidence:.3f}\")\n",
        "print(f\"Maximum confidence: {maximum_confidence:.3f}\")\n",
        "print(f\"Processing time: {processing_time:.3f} seconds\")\n",
        "print(\"=\" * 50)"
      ],
