        "\n",
        "        with open(source_file, \"r\") as f:\n",
        "            lines = f.readlines()\n",
        "\n",
        "        for line in lines:\n",
        "\n",
        "            line = line.strip()\n",
        "\n",
        "            if not line:\n",
        "                continue\n",
        "\n",
        "            parts = line.split()\n",
        "\n",
        "            # YOLO annotation must have 5 values\n",
        "            if len(parts) != 5:\n",
        "                print(\"WARNING - invalid annotation:\", source_file)\n",
