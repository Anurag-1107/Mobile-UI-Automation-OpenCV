        "    if p.suffix.lower() in [\".jpg\", \".jpeg\", \".png\"]\n",
        "])\n",
        "\n",
        "# Create image-label pairs\n",
        "pairs = []\n",
        "\n",
        "for image in images:\n",
        "    label = source_labels / f\"{image.stem}.txt\"\n",
        "\n",
        "    if label.exists():\n",
        "        pairs.append((image, label))\n",
        "\n",
        "# Same seed as before\n",
        "random.seed(42)\n",
        "random.shuffle(pairs)\n",
        "\n",
        "# 70 / 15 / 15\n",
